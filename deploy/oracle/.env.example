# Oracle Cloud Always Free VM - production environment.
# Copy to deploy/oracle/.env (git-ignored) and replace every placeholder.
# Never commit real credentials.

# --- MySQL ---
DB_NAME=innovasphere
DB_PORT=3306
DB_USERNAME=innovasphere
DB_PASSWORD=change_me
# Root password for the MySQL container. Use a different value from DB_PASSWORD.
MYSQL_ROOT_PASSWORD=change_me_too

# --- JWT ---
# Generate with: openssl rand -base64 48
JWT_SECRET=generate_with_openssl_rand_base64_48
JWT_EXPIRATION=604800000

# --- Server ---
PORT=8080

# --- CORS ---
# Cloudflare Pages origin(s), comma-separated, no trailing slash.
# Example: https://innovasphere.pages.dev
APP_CORS_ALLOWED_ORIGINS=https://your-project.pages.dev

# --- Cloudflare Tunnel ---
# Create the tunnel in the Zero Trust dashboard and route
# api.<domain> -> http://backend:8080, then paste the tunnel token here.
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token
