# Innovasphere Backend — environment template.
# Copy this file to your environment (or the host where the app runs) and fill in real values.
# No secrets are included here on purpose.

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=innovasphere
DB_USERNAME=root
DB_PASSWORD=change_me

# --- JWT ---
# Generate a strong secret of at least 32 bytes, e.g.:
#   openssl rand -base64 48
JWT_SECRET=generate_a_long_base64_secret_at_least_32_bytes
JWT_EXPIRATION=604800000

# --- CORS ---
# Comma-separated exact browser origins allowed to call the API.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Server ---
PORT=8080

# --- Spring profile: dev | prod ---
SPRING_PROFILES_ACTIVE=dev