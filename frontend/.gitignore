# Frontend .gitignore
# ===================================================================

# --- Dependencies ---
node_modules/

# --- Build output ---
dist/
build/
*.local

# --- Logs ---
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
vite-dev.log

# --- Editor directories and files ---
.vscode/*
!.vscode/extensions.json
.idea/
*.iml
*.swp
*.swo

# --- Test coverage ---
coverage/

# --- Environment files ---
.env
.env.*
!.env.example

# --- OS files ---
.DS_Store
Thumbs.db

# --- TypeScript cache ---
*.tsbuildinfo

# --- Cache ---
.eslintcache
.prettiercache

# --- Misc ---
*.tgz
.cache