# Local / single-host Docker Compose environment.
# Copy to .env (git-ignored) and replace every placeholder.
# Never commit real credentials.

# --- MySQL ---
DB_NAME=innovasphere
DB_PORT=3306
DB_USERNAME=innovasphere
DB_PASSWORD=change_me
# Root password for the MySQL container. Use a different value from DB_PASSWORD.
MYSQL_ROOT_PASSWORD=change_me_too

# --- JWT ---
# Generate with: openssl rand -base64 48
JWT_SECRET=generate_with_openssl_rand_base64_48
JWT_EXPIRATION=604800000

# --- Seed (optional) ---
# Required only when SEED_ENABLED=true. Never hardcode demo passwords.
SEED_PASSWORD=change_me_for_demo_seed

# --- Server ---
PORT=8080
SPRING_PROFILES_ACTIVE=prod

# --- CORS ---
# Comma-separated exact browser origins. The frontend runs on port 80 in the
# compose stack; port 5173 is for `npm run dev`.
APP_CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173,http://127.0.0.1:5173

# --- Frontend build ---
VITE_API_URL=http://localhost:8080
